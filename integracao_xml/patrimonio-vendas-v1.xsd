<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:uniavan:patrimonio:v1"
           xmlns:pat="urn:uniavan:patrimonio:v1"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="1.0">

  <xs:annotation>
    <xs:documentation>
      Contrato XML v1.0 para a integração de vendas confirmadas com o Sistema de
      SAC e Patrimônio. Cada item vendido gera uma ou mais unidades patrimoniais.
    </xs:documentation>
  </xs:annotation>

  <!-- Tipos simples: restringem domínio, formato e cardinalidade dos valores. -->
  <xs:simpleType name="IdentificadorType">
    <xs:restriction base="xs:string">
      <xs:minLength value="2"/>
      <xs:maxLength value="64"/>
      <xs:pattern value="[A-Za-z0-9][A-Za-z0-9._-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SkuType">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="64"/>
      <xs:pattern value="[A-Za-z0-9][A-Za-z0-9._/-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NomeType">
    <xs:restriction base="xs:string">
      <xs:minLength value="2"/>
      <xs:maxLength value="150"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DescricaoType">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="500"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DocumentoType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{5,20}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="QuantidadeType">
    <xs:restriction base="xs:positiveInteger">
      <xs:maxInclusive value="10000"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ValorMonetarioType">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:fractionDigits value="2"/>
      <xs:totalDigits value="12"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StatusVendaType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="FATURADO"/>
      <xs:enumeration value="CONCLUIDO"/>
      <xs:enumeration value="APROVADO"/>
      <xs:enumeration value="FINALIZADO"/>
      <xs:enumeration value="VENDIDO"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SistemaOrigemType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="VENDAS"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SistemaDestinoType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="PATRIMONIO"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MoedaType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="BRL"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="VersaoType">
    <xs:restriction base="xs:string">
      <xs:pattern value="1\.0"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Tipos complexos: combinam elementos, atributos e estruturas aninhadas. -->
  <xs:complexType name="CabecalhoType">
    <xs:sequence>
      <xs:element name="identificadorLote" type="pat:IdentificadorType"/>
      <xs:element name="sistemaOrigem" type="pat:SistemaOrigemType"/>
      <xs:element name="sistemaDestino" type="pat:SistemaDestinoType"/>
      <xs:element name="dataGeracao" type="xs:dateTime"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ClienteType">
    <xs:sequence>
      <xs:element name="nome" type="pat:NomeType"/>
    </xs:sequence>
    <xs:attribute name="documento" type="pat:DocumentoType" use="required"/>
  </xs:complexType>

  <xs:complexType name="ColaboradorType">
    <xs:sequence>
      <xs:element name="nome" type="pat:NomeType"/>
    </xs:sequence>
    <xs:attribute name="id" type="pat:IdentificadorType" use="required"/>
  </xs:complexType>

  <xs:complexType name="ProdutoType">
    <xs:sequence>
      <xs:element name="nome" type="pat:NomeType"/>
      <xs:element name="descricao" type="pat:DescricaoType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="sku" type="pat:SkuType" use="required"/>
  </xs:complexType>

  <xs:complexType name="ValorComMoedaType">
    <xs:simpleContent>
      <xs:extension base="pat:ValorMonetarioType">
        <xs:attribute name="moeda" type="pat:MoedaType" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="ItemType">
    <xs:sequence>
      <xs:element name="produto" type="pat:ProdutoType"/>
      <xs:element name="quantidade" type="pat:QuantidadeType"/>
      <xs:element name="valorUnitario" type="pat:ValorComMoedaType"/>
      <xs:element name="garantiaAte" type="xs:date" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="pat:IdentificadorType" use="required"/>
  </xs:complexType>

  <xs:complexType name="ItensType">
    <xs:sequence>
      <xs:element name="item" type="pat:ItemType" minOccurs="1" maxOccurs="1000"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="VendaType">
    <xs:sequence>
      <xs:element name="dataVenda" type="xs:date"/>
      <xs:element name="status" type="pat:StatusVendaType"/>
      <xs:element name="cliente" type="pat:ClienteType"/>
      <xs:element name="colaborador" type="pat:ColaboradorType"/>
      <xs:element name="itens" type="pat:ItensType"/>
    </xs:sequence>
    <xs:attribute name="id" type="pat:IdentificadorType" use="required"/>
  </xs:complexType>

  <xs:complexType name="VendasType">
    <xs:sequence>
      <xs:element name="venda" type="pat:VendaType" minOccurs="1" maxOccurs="1000"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="IntegracaoPatrimonioType">
    <xs:sequence>
      <xs:element name="cabecalho" type="pat:CabecalhoType"/>
      <xs:element name="vendas" type="pat:VendasType"/>
    </xs:sequence>
    <xs:attribute name="versao" type="pat:VersaoType" use="required"/>
  </xs:complexType>

  <xs:element name="integracaoPatrimonio" type="pat:IntegracaoPatrimonioType"/>
</xs:schema>
